{
    "Version": "2012-10-17",
    "Id": "123",
    "Statement": [
        {
            "Sid": "AllowAll",
            "Effect": "Allow",
            "Action": ["s3:*", "ec2:*"],
            "Resource": "arn:aws:s3:::bucket1/*"
        },
        {
            "Sid": "DenyOutsideOffice",
            "Effect": "Deny",
            "Action": "*",
            "Resource": "*",
            "Condition": {"NotIpAddress": {"aws:SourceIp": ["192.0.2.0/24", "203.0.113.0/24"]}}
        }
    ]
}
